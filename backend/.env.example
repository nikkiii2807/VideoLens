# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Processing Hyperparameters
MAX_DURATION_SECONDS=60.0
MAX_FILE_SIZE_MB=50
SAMPLING_FPS=2.0
SIMILARITY_THRESHOLD=0.92

# Temporal Reasoning
TEMPORAL_WINDOW_SECONDS=4.0
RETRIEVAL_TOP_K=5

# Multimodal Scoring Weights
WEIGHT_TEXT=0.35
WEIGHT_VISUAL=0.35
WEIGHT_OCR=0.20
WEIGHT_TEMPORAL=0.10

# Multimodal LLM/VLM Provider ("gemini", "openai", "offline")
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
